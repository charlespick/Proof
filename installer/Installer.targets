<Project>

  <!--
    Shared by the MSI projects. Each sets PayloadProject (the program's .csproj), then imports this file. The
    program's project makes a win-x64 publish self-contained and single-file, so a machine needs nothing but the MSI.
  -->

  <PropertyGroup>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- ICE61 flags AllowSameVersionUpgrades, which is deliberate (build/Version.targets). -->
    <SuppressIces>ICE61</SuppressIces>
  </PropertyGroup>

  <Target Name="PublishPayload" DependsOnTargets="ProofVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PayloadDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'payload'))</PayloadDir>
    </PropertyGroup>

    <!-- The version goes down explicitly, so the program carries exactly the version the MSI does. -->
    <Exec Command="dotnet publish &quot;$(PayloadProject)&quot; -c $(Configuration) -r win-x64 -p:DebugType=none -p:ProofVersion=$(ProofVersion) -p:ProofCommit=$(ProofCommit) -p:ProofCommitsSinceTag=$(ProofCommitsSinceTag) -o &quot;$(PayloadDir.TrimEnd('\'))&quot;" />

    <PropertyGroup>
      <DefineConstants>$(DefineConstants);ProductVersion=$(ProofMsiVersion);PayloadDir=$(PayloadDir);LicenseFile=$(ProofRepoRoot)LICENSE</DefineConstants>
    </PropertyGroup>
  </Target>

</Project>
