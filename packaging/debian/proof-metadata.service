[Unit]
Description=Proof instance metadata for this VM
Documentation=https://github.com/charlespick/Proof
# Early enough for cloud-init, which reads the metadata from it.
DefaultDependencies=no
Conflicts=shutdown.target
After=local-fs.target systemd-modules-load.service
Before=cloud-init-local.service cloud-init.service shutdown.target

[Service]
Type=notify
ExecStart=/usr/bin/proof-metadata
Restart=always
RestartSec=5
# It needs loopback and the Hyper-V socket, and writes nothing.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX AF_VSOCK
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
