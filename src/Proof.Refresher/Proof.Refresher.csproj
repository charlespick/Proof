<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>proof-refresher</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Proof.Refresher-937e63d3-38cc-4f3e-88c1-75351becf880</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <!-- WMI for the Hyper-V KVP methods. It uses built-in COM, so publish self-contained single-file, not NativeAOT. -->
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="packages.lock.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Proof.Shared\Proof.Shared.csproj" />
  </ItemGroup>

  <!--
    How the refresher ships: one self-contained file, so `dotnet publish -r win-x64` is the whole command. Set here
    rather than on the command line, where the properties would reach Proof.Shared's restore too.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <!-- Every build warns about what single-file would break. It also keeps the analyzer package in every restore, so
       the lock file is the same with and without a runtime identifier. -->
  <PropertyGroup>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>
</Project>
