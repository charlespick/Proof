<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>proof</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Images carry one self-contained file and may lack ICU, so the client needs no culture data. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Turns on the trim and AOT analyzers, so a trimmed single file or a NativeAOT build behaves like this one. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    How the client ships: one self-contained, trimmed file per runtime, so `dotnet publish -r <rid>` is the whole
    command. Set here rather than on the command line, where the properties would reach Proof.Shared's restore too
    and disagree with its lock file.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Proof.Shared\Proof.Shared.csproj" />
  </ItemGroup>

</Project>
